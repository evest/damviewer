# Optimizely CMP Library API Configuration
#
# To get credentials:
# 1. Go to CMP Admin > Apps and Webhooks > Register App
# 2. Enable "Allow Client Credentials" in Authorization Permissions
# 3. Copy client_id and client_secret here

CMP_CLIENT_ID=your-client-id-here
CMP_CLIENT_SECRET=your-client-secret-here
CMP_API_BASE_URL=https://api.cmp.optimizely.com/v3
CMP_AUTH_TOKEN_URL=https://accounts.cmp.optimizely.com/o/oauth2/v1/token
